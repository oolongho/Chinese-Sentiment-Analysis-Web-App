# 中文情感分析系统环境变量配置
# 复制此文件为 .env 并修改配置值

# ===========================================
# 必需配置
# ===========================================

# JWT 密钥（必需）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-to-random-string

# 管理员密码（二选一）
# 方式1: 直接配置明文密码（不推荐）
ADMIN_PASSWORD=your-admin-password

# 方式2: 配置密码哈希值（推荐）
# 生成方式: python -c "import hashlib; print(hashlib.sha256('your_password'.encode()).hexdigest())"
# ADMIN_PASSWORD_HASH=5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8

# ===========================================
# 可选配置
# ===========================================

# CORS 允许的来源（多个域名用逗号分隔）
# 开发环境示例: http://localhost:3000,http://localhost:5173
# 生产环境示例: https://your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 数据库URL（可选，默认使用SQLite）
# DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:password@localhost/dbname

# ===========================================
# 说明
# ===========================================
# 1. SECRET_KEY 必须配置为安全的随机字符串
# 2. ADMIN_PASSWORD 或 ADMIN_PASSWORD_HASH 必须配置其一
# 3. 生产环境请使用 ADMIN_PASSWORD_HASH
# 4. CORS_ORIGINS 生产环境请配置具体域名，不要使用 *
